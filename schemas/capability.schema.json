    "compensate_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Compensate Reason"
    },
    "data": {
      "$ref": "#/$defs/Data"
    },
    "examples": {
      "default": [],
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Examples",
      "type": "array"
