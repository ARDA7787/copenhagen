# Copy to .env for local development. Never commit .env.
# Domain workers (COPENHAGEN_PROCESS=domain-worker) never load this file.

ENV=dev

# Control plane database (control process only; I2).
DATABASE_URL=postgresql+asyncpg://copenhagen_app:copenhagen_app@localhost:5432/copenhagen
DATABASE_OWNER_URL=postgresql+asyncpg://copenhagen_owner:copenhagen_owner@localhost:5432/copenhagen

# Temporal dev server (UI on http://localhost:8233).
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Dev-only conveniences. Refused at startup when ENV=prod.
COPENHAGEN_DEV_LOGIN=1

# Vendor credentials, one per credential_ref, read only by the worker whose queue owns it:
# COPENHAGEN_SECRET_<NAME>=...
