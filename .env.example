# Copy to .env for local development. Never commit .env.
# Domain workers (COPENHAGEN_PROCESS=domain-worker) never load this file.

ENV=dev

# Control plane database (control process only; I2).
DATABASE_URL=postgresql+psycopg://copenhagen_app:copenhagen_app@localhost:5432/copenhagen
DATABASE_OWNER_URL=postgresql+psycopg://copenhagen_owner:copenhagen_owner@localhost:5432/copenhagen

# Temporal dev server (UI on http://localhost:8233).
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Dev-only conveniences. Refused at startup when ENV=prod.
COPENHAGEN_DEV_LOGIN=1

# Domain workers: backend base URLs and adapter plugins.
# COPENHAGEN_BACKENDS_FILE=/etc/copenhagen/backends.yaml
# COPENHAGEN_ADAPTERS=name=package.module:factory
# Local development against the simulator (`uv run python -m copenhagen_devkit mockworld`):
# COPENHAGEN_BACKENDS_FILE=examples/config/backends.dev.yaml
# COPENHAGEN_ALLOW_INSECURE_BACKENDS=1
# COPENHAGEN_ADAPTERS=fake=copenhagen_devkit.fake:create

# Vendor credentials, one per credential_ref, read only by the worker whose queue owns it:
# COPENHAGEN_SECRET_<NAME>=...

TENANT_ID=your-company
PUBLIC_URL=http://localhost:8000
# Each event source signs with its own secret: COPENHAGEN_HOOK_SECRET_<SOURCE>
# (e.g. COPENHAGEN_HOOK_SECRET_STRIPE). HOOK_SECRET is a development-only
# fallback shared by every source and is ignored in production.
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ALLOWED_DOMAIN=your-company.com
# COPENHAGEN_AUTHORIZATION_KEY=... (same control/worker signing key)

# Optional custom Cedar policy directory; defaults are bundled in the package.
# POLICY_DIRECTORY=/etc/copenhagen/policies
# CALLBACK_SECRET=... (separate secret for asynchronous backend callbacks)
# Approval, task and stuck-run notifications. Without a URL they are logged only.
# The receiver verifies X-Copenhagen-Signature (HMAC-SHA256 of "<timestamp>.<body>").
# NOTIFY_WEBHOOK_URL=https://hooks.your-company.com/copenhagen
# NOTIFY_WEBHOOK_SECRET=... (at least 32 characters)
# Minutes between passes that reconcile runs with Temporal and expire stale approvals.
# RECONCILE_MINUTES=5
# Export these transport variables to API, control and domain processes:
# TEMPORAL_TLS=1
# TEMPORAL_API_KEY=...
